<% unless AppConfig.has_key?(:aspace_custom_restrictions_pui_enhance) && AppConfig[:aspace_custom_restrictions_pui_enhance] == false %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&&icon_names=warning" />
  <%= stylesheet_link_tag "#{AppConfig[:public_proxy_prefix]}assets/#{AppConfig[:aspace_custom_restrictions_pui_assets_filename]}.css" %>
  <%#= javascript_include_tag "#{AppConfig[:public_proxy_prefix]}assets/#{AppConfig[:aspace_custom_restrictions_pui_assets_filename]}.js" %>
  
  <%= javascript_include_tag "#{AppConfig[:public_proxy_prefix]}assets/custom_restrictions_pui.js" %>
  <%= javascript_include_tag "#{AppConfig[:public_proxy_prefix]}assets/custom_restrictions_tree_base.js" %>
  <%= javascript_include_tag "#{AppConfig[:public_proxy_prefix]}assets/custom_restrictions_tree_additions_pui.js" %>
  <%= javascript_include_tag "#{AppConfig[:public_proxy_prefix]}assets/custom_restrictions_infinite_tree.js" %>
  <%= javascript_include_tag "#{AppConfig[:public_proxy_prefix]}assets/custom_restrictions_infinite_records.js" %>
  <%= javascript_include_tag "#{AppConfig[:public_proxy_prefix]}assets/custom_restrictions_infinite_scroll.js" %>
  <% 
    custom_restrictions_object_data = {}
    add_restrictions = should_add_custom_restrictions?(controller)
    if add_restrictions
      unless @results.nil?
        @results.records.each do |full_result|
          result = full_result.raw
          unless result.nil? || result['custom_restrictions_u_sstr'].nil?
            restrictions = []

            raw_restrictions = result['custom_restrictions_u_sstr'].nil? ? {} : ASUtils.json_parse(result['custom_restrictions_u_sstr'].first)
            raw_restrictions.each do |level, restriction|
              restriction_message = I18n.t('enumerations.custom_restriction_type.' + restriction, default: I18n.t('enumerations.custom_restriction_type.default'))
              restrictions << I18n.t('custom_restrictions_and_context.restriction_label', 
                                  level: level.titleize,
                                  restriction: restriction_message
                              )
            end
            
            custom_restrictions_object_data[result['id']] = {
              'custom_restrictions' => restrictions,
            }
          end
        end
      end
    end
  %>

  <% if add_restrictions %>

    <script id="custom-restrictions-data" type="application/json">
      <%= raw safe_json_script(custom_restrictions_object_data) %>
    </script>
    <% tree_enabled = !(AppConfig.has_key?(:aspace_custom_restrictions_pui_tree) && AppConfig[:aspace_custom_restrictions_pui_tree] == false) %>
    <% if tree_enabled && !is_search?(controller) && @result&.repository_information %>
      <script id="custom-restrictions-repo-data" type="application/json">
        <%= raw safe_json_script({
          repo_uri: @result.repository_information.dig('top', 'uri'),
          app_version: AppConfig[:custom_restrict_app_version]
        }) %>
      </script>
    <% end %>
    <script>
      onPageLoad(() => {
        const data = JSON.parse(document.getElementById('custom-restrictions-data').textContent);
        const puiSearchRestrictions = new CustomRestrictionsPui(data);
        puiSearchRestrictions.setupDecoratePuiSearch();
        initializeTree();
      });
    </script>
  <% end %>
<% end %>
